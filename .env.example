# PharmaSpark Environment Variables

# Server Configuration
PORT=8000
NODE_ENV=development

# Database
DB_PATH=./data/pharmaspark.db

# Authentication
JWT_SECRET=your-secret-key-here

# API Limits
FREE_TIER_API_LIMIT=1000
PRO_TIER_API_LIMIT=10000
ENTERPRISE_TIER_API_LIMIT=100000

# CORS
CORS_ORIGIN=http://localhost:8097

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/pharmaspark.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=52428800

# External Services
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-email-password

# Stripe (for payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Analytics
# POSTHOG_API_KEY=phc_...
# SENTRY_DSN=https://...@sentry.io/...
