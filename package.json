{
  "name": "pharmaspark",
  "version": "0.2.0",
  "description": "PharmaSpark — 3D Gaussian Splatting renderer for pharmaceutical & biomedical visualization",
  "type": "module",
  "main": "./dist/pharmaspark.cjs.js",
  "module": "./dist/pharmaspark.module.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pharmaspark.module.js",
      "require": "./dist/pharmaspark.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8097",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode dev",
    "build:watch": "onchange 'src/**/*.{ts,glsl}' -- npm run build:dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format .",
    "lint": "biome check .",
    "cli": "node --loader ts-node/esm src/cli/index.ts",
    "demo": "vite --host 0.0.0.0 --port 8097",
    "server": "cd server && npm run dev",
    "server:start": "cd server && npm start",
    "server:build": "cd server && npm run build",
    "start": "concurrently \"npm run demo\" \"npm run server\"",
    "deploy": "npm run build && npm run server:build"
  },
  "keywords": [
    "3d-gaussian-splatting",
    "molecular-visualization",
    "drug-discovery",
    "protein-structure",
    "pharmaceutical",
    "three-js",
    "webgl2",
    "biomedical"
  ],
  "author": "MoKangMedical",
  "license": "MIT",
  "dependencies": {
    "@sparkjsdev/spark": "^2.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^8.2.2",
    "vite": "^6.3.2",
    "vitest": "^3.1.1"
  }
}
